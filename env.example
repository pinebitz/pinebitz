# Copy to .env and load in your shell, or set variables manually.
# Create API keys on Binance USD-M Futures TESTNET only (not mainnet).
# https://testnet.binancefuture.com/

BINANCE_USDM_TESTNET_API_KEY=
BINANCE_USDM_TESTNET_SECRET=

# Postgres (Docker default: localhost:15432 / db pinebitz user pinebitz / pass pinebitz)
DATABASE_URL=postgresql+asyncpg://pinebitz:pinebitz@127.0.0.1:15432/pinebitz

# Prometheus scrape auth (production-ready)
# METRICS_PROM_AUTH_MODE: owner_key | token | localhost | token_or_localhost
# METRICS_PROM_ENABLED: true | false
# METRICS_PROM_ALLOWLIST: comma-separated IP/CIDR list (e.g. 127.0.0.1,10.0.0.0/8)
METRICS_PROM_ENABLED=true
METRICS_PROM_AUTH_MODE=token_or_localhost
METRICS_PROM_TOKEN=change-me
METRICS_PROM_ALLOWLIST=127.0.0.1,::1

# Docker compose stack (api + postgres + prometheus)
# API:        http://127.0.0.1:18000
# Prometheus: http://127.0.0.1:19090
# Start:      docker compose up -d --build
# Stop:       docker compose down

# From repo root: pip install -e .
# Docker: docker compose up -d postgres
# Migrations: alembic upgrade head
# Smoke: python scripts/pg_ping.py || python scripts/smoke_usdm_testnet.py

