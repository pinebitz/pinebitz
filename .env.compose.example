# Copy to .env.compose for local overrides used by docker compose.
# Keep METRICS_PROM_TOKEN in sync with deploy/prometheus/prometheus.yml unless you also update that file.

POSTGRES_USER=pinebitz
POSTGRES_PASSWORD=pinebitz
POSTGRES_DB=pinebitz
POSTGRES_HOST_PORT=15432
API_HOST_PORT=18000
PROMETHEUS_HOST_PORT=19090

METRICS_PROM_ENABLED=true
METRICS_PROM_AUTH_MODE=token
METRICS_PROM_TOKEN=change-me
METRICS_PROM_ALLOWLIST=0.0.0.0/0
